# Connect4 RV6L Deployment - Beispiel-Umgebungsvariablen
# Kopieren Sie diese Datei zu `.env` und passen Sie Werte an.



# Cloudflare Tunnel Token
CLOUDFLARED_TOKEN=

# Telegram-Bot für kritische Fehler (Token von @BotFather), leer = aus
TELEGRAM_BOT_TOKEN=


# Frontend-Adresse für QR-Codes und Verlinkungen (Nur bei Bedarf überschreiben)
#FRONTEND_ADDRESS=http://localhost:8080